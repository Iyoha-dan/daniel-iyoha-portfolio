---
// The arcade "mini player" in the Bug hunt section: a small screen where the ship plays itself,
// and a Play button that opens the full game in a dialog. Game code: src/scripts/bug-blaster.ts.
---

<div class="mini" data-blaster>
  <div class="mini-screen" aria-hidden="true">
    <canvas data-mini-canvas></canvas>
  </div>
  <div class="mini-info">
    <p class="mini-kicker">Arcade</p>
    <h3 class="mini-title">Bug blaster</h3>
    <p class="mini-text">Prefer something faster? Shoot the bugs before they ship to production.</p>
    <div class="mini-actions">
      <button type="button" class="mini-play" data-blaster-open>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1.5v9l8-4.5z" fill="currentColor" /></svg>
        Play
      </button>
      <span class="mini-best" data-blaster-best hidden></span>
    </div>
  </div>
</div>

<dialog class="arcade" aria-labelledby="arcade-title" data-blaster-dialog data-state="ready" data-score="0" data-lives="3" data-sprint="1">
  <div class="arcade-bar">
    <h2 id="arcade-title">Bug blaster</h2>
    <div class="arcade-tools">
      <button type="button" class="arcade-btn" data-blaster-sound aria-pressed="false">Sound off</button>
      <button type="button" class="arcade-btn arcade-close" data-blaster-close aria-label="Close the game">✕</button>
    </div>
  </div>
  <div class="arcade-stage" data-blaster-stage>
    <canvas data-game-canvas tabindex="0" autofocus role="img" aria-label="Bug blaster game screen. Press Space to start."></canvas>
  </div>
  <p class="arcade-help">Arrow keys or WASD to move, Space to fire, P to pause. On a phone, drag to move; it fires by itself.</p>
  <p class="sr-only" aria-live="polite" data-blaster-live></p>
</dialog>

<script>
  import { BugBlaster, W, H, sound } from '../scripts/bug-blaster';

  const root = document.querySelector<HTMLElement>('[data-blaster]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-blaster-dialog]');
  if (root && dialog) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-blaster-open]')!;
    const bestEl = root.querySelector<HTMLElement>('[data-blaster-best]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-blaster-stage]')!;
    const canvas = dialog.querySelector<HTMLCanvasElement>('[data-game-canvas]')!;
    const soundBtn = dialog.querySelector<HTMLButtonElement>('[data-blaster-sound]')!;
    const live = dialog.querySelector<HTMLElement>('[data-blaster-live]')!;

    const showBest = (best: number) => {
      bestEl.hidden = !best;
      bestEl.textContent = `Best: ${best}`;
    };

    /* The mini screen: the demo plays itself while it's on screen (one still frame with reduced motion). */
    const mini = new BugBlaster(root.querySelector<HTMLCanvasElement>('[data-mini-canvas]')!, { demo: true });
    showBest(mini.best);
    for (let i = 0; i < 60 * 4; i++) mini.update(1 / 60); // start mid-game, with bugs on screen
    mini.draw();
    let miniVisible = false;
    const syncMini = () => {
      if (miniVisible && !dialog.open && !document.hidden && !reduced.matches) mini.run();
      else mini.stop();
    };
    new IntersectionObserver(([entry]) => {
      miniVisible = entry.isIntersecting;
      syncMini();
    }).observe(root);
    document.addEventListener('visibilitychange', syncMini);

    /* The full game */
    const game = new BugBlaster(canvas);
    const report = () => {
      dialog.dataset.state = game.state;
      dialog.dataset.score = String(game.score);
      dialog.dataset.lives = String(game.lives);
      dialog.dataset.sprint = String(game.sprint);
    };
    game.onChange = report;
    game.onGameOver = (score, best) => {
      live.textContent = `Game over. ${score} points. Best ${best}.`;
      showBest(best);
      // Same moment as the end of a bug hunt: the feedback card may ask a quick question.
      document.dispatchEvent(new CustomEvent('bughunt:over'));
    };

    // Pixel-perfect scaling: whole-number steps when there's room, otherwise fill the space.
    const fit = () => {
      // The stage's content box (minus padding), so the canvas can never push the window wider.
      const pad = 16;
      const s = Math.min((stage.clientWidth - pad) / W, (stage.clientHeight - pad) / H);
      const scale = s >= 2 ? Math.floor(s) : s;
      canvas.style.width = `${Math.floor(W * scale)}px`;
      canvas.style.height = `${Math.floor(H * scale)}px`;
    };
    new ResizeObserver(fit).observe(stage);

    const open = () => {
      dialog.showModal();
      canvas.focus();
      fit();
      game.draw();
      game.run();
      syncMini();
      report();
    };
    const close = () => {
      game.pause();
      game.stop();
      if (dialog.open) dialog.close();
    };
    openBtn.addEventListener('click', open);
    dialog.querySelector('[data-blaster-close]')!.addEventListener('click', close);
    dialog.addEventListener('close', () => {
      game.pause();
      game.stop();
      syncMini();
      openBtn.focus();
    });
    // A click on the backdrop (outside the panel) closes too.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) game.pause();
    });

    /* Keyboard */
    const map: Record<string, string> = {
      ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right',
      ArrowUp: 'up', KeyW: 'up', ArrowDown: 'down', KeyS: 'down', Space: 'fire',
    };
    dialog.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('button') && (e.code === 'Space' || e.code === 'Enter')) return; // let buttons work
      if ((e.code === 'Space' || e.code === 'Enter') && game.state !== 'play') {
        e.preventDefault();
        game.start();
        return;
      }
      if (e.code === 'KeyP') {
        if (game.state === 'play') game.pause();
        else game.start();
        return;
      }
      const k = map[e.code];
      if (k) {
        e.preventDefault();
        game.keys.add(k);
      }
    });
    dialog.addEventListener('keyup', (e) => {
      const k = map[e.code];
      if (k) game.keys.delete(k);
    });

    /* Touch and mouse: drag to move (fires while held); a tap starts or resumes. */
    const toGame = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
    };
    canvas.addEventListener('pointerdown', (e) => {
      if (game.state !== 'play') {
        game.start();
        return;
      }
      canvas.setPointerCapture(e.pointerId);
      game.pointer = toGame(e);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (game.pointer) game.pointer = toGame(e);
    });
    const release = () => (game.pointer = null);
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);

    /* Sound: off by default, remembered */
    const setSound = (on: boolean) => {
      sound.on = on;
      soundBtn.setAttribute('aria-pressed', String(on));
      soundBtn.textContent = on ? 'Sound on' : 'Sound off';
      try {
        localStorage.setItem('bug-blaster-sound', on ? 'on' : 'off');
      } catch {}
    };
    try {
      setSound(localStorage.getItem('bug-blaster-sound') === 'on');
    } catch {}
    soundBtn.addEventListener('click', () => setSound(!sound.on));
  }
</script>

<style>
  /* The mini player */
  .mini {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    margin-top: 28px;
    padding: 12px;
    border-radius: 16px;
    background: var(--term);
    color: var(--term-text);
  }
  .mini-screen {
    overflow: hidden;
    border-radius: 10px;
    background: #0b0b0a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  /* Smooth downscale: at less than 1× pixelated scaling drops whole pixels from the sprites. */
  .mini-screen canvas {
    display: block;
    width: 120px;
    height: 160px;
  }
  .mini-kicker {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--term-pass);
  }
  .mini-title {
    margin-top: 2px;
    font-size: 1.25rem;
    font-weight: 720;
    letter-spacing: -0.015em;
  }
  .mini-text {
    margin-top: 4px;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--term-dim);
  }
  .mini-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 12px;
  }
  .mini-play {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--term-pass);
    color: #0b0b0a;
    font: inherit;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .mini-play:active {
    transform: scale(0.97);
  }
  .mini-play:focus-visible {
    outline: 2px solid var(--term-text);
    outline-offset: 3px;
  }
  .mini-best {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--term-dim);
  }
  .mini-best[hidden] {
    display: none;
  }

  /* The game window */
  .arcade {
    width: min(560px, calc(100vw - 32px));
    height: min(860px, calc(100dvh - 32px));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 20px;
    background: #0b0b0a;
    color: var(--term-text);
    overflow: hidden;
  }
  .arcade[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: arcade-in 220ms var(--ease-out);
  }
  .arcade::backdrop {
    background: rgb(11 11 10 / 0.78);
  }
  @keyframes arcade-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arcade[open] {
      animation: none;
    }
  }
  .arcade-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 18px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .arcade-bar h2 {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--term-pass);
  }
  .arcade-tools {
    display: flex;
    gap: 4px;
  }
  .arcade-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--term-dim);
    font-family: var(--mono);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .arcade-btn[aria-pressed='true'] {
    color: var(--term-pass);
  }
  .arcade-close {
    font-size: 1.1rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .arcade-btn:hover {
      background: rgb(255 255 255 / 0.08);
      color: var(--term-text);
    }
  }
  .arcade-btn:focus-visible {
    outline: 2px solid var(--term-pass);
    outline-offset: -2px;
  }
  .arcade-stage {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    padding: 8px;
    overflow: hidden;
  }
  .arcade-stage canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
    image-rendering: pixelated;
    touch-action: none;
    cursor: crosshair;
    outline: none;
  }
  .arcade-stage canvas:focus-visible {
    box-shadow: 0 0 0 2px rgb(95 208 154 / 0.5);
  }
  .arcade-help {
    padding: 10px 18px 14px;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--term-dim);
    text-align: center;
  }
  /* Phones: the whole screen is the game. */
  @media (max-width: 560px) {
    .arcade {
      width: 100vw;
      height: 100dvh;
      border: 0;
      border-radius: 0;
    }
    .arcade-help {
      display: none;
    }
  }
</style>
