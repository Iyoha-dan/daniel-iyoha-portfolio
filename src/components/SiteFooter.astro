---
import { person } from '../data/profile';
---

<footer class="foot">
  <div class="wrap foot-inner">
    <p>© {new Date().getFullYear()} {person.name}</p>
    <p>
      Built with Astro. Tested with Playwright:
      <a href={`${person.repo}/blob/main/tests/site.spec.ts`} target="_blank" rel="noopener noreferrer">read the tests ↗</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--term);
    color: var(--term-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-block: 22px;
    /* Rule drawn inside the gutters so it lines up with the content above. */
    background: linear-gradient(rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.08)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  .foot a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--term-text);
    text-underline-offset: 3px;
  }
</style>
