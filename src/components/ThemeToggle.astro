---
// Light/dark switch. The new theme spreads out from the button as a growing circle
// (View Transitions API); browsers without it, and visitors who prefer reduced motion,
// get an instant switch instead.
import { ui, type Lang } from '../i18n';
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui[lang].theme;
---

<button class="theme-toggle" type="button" aria-label={t.toDark} data-theme-toggle data-label-dark={t.toDark} data-label-light={t.toLight}>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.4 8.4 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const dark = matchMedia('(prefers-color-scheme: dark)');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (dark.matches ? 'dark' : 'light');

  const label = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', (next === 'dark' ? button.dataset.labelDark : button.dataset.labelLight) ?? `Switch to ${next} theme`);
  };

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    // Keep the browser's address bar colour in step with the page.
    const paper = getComputedStyle(root).getPropertyValue('--paper').trim();
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', paper));
    label();
  };

  button.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    if (!document.startViewTransition || reduceMotion.matches) {
      apply(next);
      return;
    }
    // The circle starts at the button's centre and grows to reach the farthest corner.
    const box = button.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    const transition = document.startViewTransition(() => apply(next));
    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });

  // Follow the device again only while the visitor hasn't picked a theme.
  dark.addEventListener('change', label);
  label();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: 4px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  @media (hover: hover) {
    .theme-toggle:hover {
      background: var(--paper-2);
    }
  }
  .icon {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 250ms ease,
      transform 400ms var(--ease-out);
  }
  /* Show the icon of the theme you'd switch to: a moon in light mode, a sun in dark. */
  .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(:root[data-theme='dark']) .sun {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      opacity: 1;
      transform: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.6);
    }
  }
</style>
