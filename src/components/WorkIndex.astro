---
// The homepage's Work section: one list of project links, laid out two ways.
// Desktop (>960px): expanding panels. All five sit side by side in their brand colours; pointing
//   at or tabbing to one widens it into the full card. The first tap on a touch screen opens a
//   panel, the next follows the link.
// Phones and tablets: a scroll-snap carousel. The phone's own swiping, one big card in focus,
//   the next one peeking in, plus dots and a "1 / 5" count.
// Either way the card in focus replays its checks (Lighthouse scores, release flows, the Linkhut
// run), ending on the real figures from profile.ts. Prototypes compared in the "Work preview
// options" artifact (Nov 2026).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/profile';
import { caseStudies } from '../data/case-studies';
import { ui, type Lang } from '../i18n';

interface Props {
  projects: Project[];
  lang?: Lang;
}
const { projects, lang = 'en' } = Astro.props;
const t = ui[lang].work;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const shot = (p: Project) => p.shots && shots[`../assets/work/${p.shots}-desktop.jpg`]?.default;
// Projects with a case study open their own page; the rest jump to their section below.
const href = (p: Project) => (caseStudies[p.slug] ? `/work/${p.slug}` : `#${p.slug}`);
// The proof in words, for screen readers (the visual reports are aria-hidden). Each link's name
// comes from its own visible text plus this, so what voice-control users see is what they can say.
// Empty when the visible stat already says it plainly.
const spokenProof = (p: Project) => {
  if (p.scores)
    return `${t.spokenScores}: ${p.scores.values.map((s) => `${s.label === 'SEO' || lang === 'de' ? s.label : s.label.toLowerCase()} ${s.value}`).join(', ')}`;
  if (p.results) return t.spokenCases(p.results.label, p.results.passed + p.results.failed, p.results.passed, p.results.failed, p.bugs?.length ?? 0);
  if (p.checks) return `${t.summary(p.checks.length, p.checksLabel ?? 'checks')}: ${p.checks.join(', ')}`;
  return '';
};
---

<section id="work" class="work-index wrap section-rule" aria-labelledby="work-title">
  {/* The old Websites and QA sections lived here; links shared before still land on the work. */}
  <span id="websites" class="anchor" aria-hidden="true"></span>
  <span id="qa" class="anchor" aria-hidden="true"></span>
  <div class="section-head" data-reveal>
    <h2 id="work-title">{ui[lang].nav.work}</h2>
    <p class="section-lede">
      {t.lede}
    </p>
  </div>

  <ol class="track" data-work-list>
    {
      projects.map((p, i) => {
        const img = shot(p);
        const proof = spokenProof(p);
        return (
          <li data-index={i}>
            <a
              class="tile"
              href={href(p)}
              data-tile
              style={p.accent ? `--accent:${p.accent}` : undefined}
            >
              <span class="tile-label" aria-hidden="true">
                <span class="tile-title">{p.title}</span>
              </span>
              <span class="card" data-card={i}>
                <span class="card-top">
                  {img ? (
                    <>
                      <Image src={img} alt="" widths={[480, 720, 1080]} sizes="(min-width: 961px) 640px, 82vw" class="card-shot" />
                      {p.scores && (
                        <span class="lh" aria-hidden="true">
                          <span class="lh-cmd">$ lighthouse {p.link?.label ?? p.title}</span>
                          {p.scores.values.map((s, k) => (
                            <span class="lh-row step" style={`--i:${k}`}>
                              <span class="mark" style={`--done:${k * 140 + 640}ms`}>
                                <span class="pend">·</span>
                                <span class="tick">✓</span>
                              </span>
                              <span class="lh-label">{s.label}</span>
                              <span class="lh-score" data-count={s.value} data-at={k * 140 + 150} data-for="520">
                                {s.value}
                              </span>
                            </span>
                          ))}
                        </span>
                      )}
                    </>
                  ) : (
                    <span class="report" aria-hidden="true">
                      <span class="report-title">{p.results ? t.testReport : t.checklist}</span>
                      {p.results ? (
                        <>
                          <span class="report-line">
                            {p.results.label}:{' '}
                            <span data-count={p.results.passed + p.results.failed} data-at="150" data-for="900">
                              {p.results.passed + p.results.failed}
                            </span>{' '}
                            {t.testCases}
                          </span>
                          <span class="bar fill" style={`grid-template-columns:${p.results.passed}fr ${p.results.failed}fr`}>
                            <span class="bar-pass" />
                            <span class="bar-fail" />
                          </span>
                          <span class="report-line legend step" style="--at:1050ms">
                            <span class="pass">{p.results.passed} {t.passed}</span>
                            <span class="fail">{p.results.failed} {t.failed}</span>
                          </span>
                          {p.bugs?.map((b, k) => (
                            <span class="report-line bug step" style={`--at:${1250 + k * 180}ms`}>
                              <span>
                                <span class="bug-id">{b.id}</span> · {b.severity}
                              </span>
                              <span>{b.title}</span>
                            </span>
                          ))}
                        </>
                      ) : (
                        <>
                          {(p.checks ?? []).map((c, k) => (
                            <span class="report-line step" style={`--i:${k}`}>
                              <span class="mark" style={`--done:${k * 140 + 360}ms`}>
                                <span class="pend">·</span>
                                <span class="tick">✓</span>
                              </span>
                              {c}
                            </span>
                          ))}
                          <span class="report-line summary step" style={`--at:${(p.checks?.length ?? 0) * 140 + 450}ms`}>
                            {t.summary(p.checks?.length ?? 0, p.checksLabel ?? 'checks')}
                          </span>
                        </>
                      )}
                    </span>
                  )}
                </span>
                {/* Title first so screen readers lead with it; CSS shows the kind above it. */}
                <span class="card-body">
                  <span class="card-title">{p.title}</span>
                  <span class="sr-only">, </span>
                  <span class="card-kind">{p.kind}</span>
                  {/* The stat in symbols ("93 · 96") is replaced by the proof in words where there is one. */}
                  {p.stat && !proof && <span class="sr-only">. </span>}
                  {p.stat && <span class="card-stat" aria-hidden={proof ? 'true' : undefined}>{p.stat}</span>}
                  {proof && <span class="sr-only">. {proof}</span>}
                  {caseStudies[p.slug] && (
                    <>
                      <span class="sr-only">. </span>
                      <span class="card-cta">
                        {t.cta} <span class="cta-arrow" aria-hidden="true">→</span>
                      </span>
                    </>
                  )}
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <div class="track-ctrl" data-track-ctrl>
    <span class="track-count" data-track-count aria-hidden="true">1 / {projects.length}</span>
    <div class="dots">
      {projects.map((p, i) => <button type="button" data-dot={i} aria-label={t.show(p.title)} aria-current={i === 0 ? 'true' : 'false'} />)}
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-work-list]');
  if (list) {
    const items = [...list.querySelectorAll<HTMLElement>('li[data-index]')];
    const tiles = items.map((li) => li.querySelector<HTMLAnchorElement>('[data-tile]')!);
    const cards = items.map((li) => li.querySelector<HTMLElement>('[data-card]')!);
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const count = document.querySelector<HTMLElement>('[data-track-count]')!;
    const desk = matchMedia('(min-width: 961px)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    /* The check replay: rows step in and tick (CSS, under .is-running), numbers count up. */
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    let runId = 0;
    const run = (card: HTMLElement) => {
      if (reduced.matches) return;
      const id = ++runId;
      card.classList.remove('is-running');
      void card.offsetWidth; // restart the CSS animations
      card.classList.add('is-running');
      const counters = [...card.querySelectorAll<HTMLElement>('[data-count]')];
      const start = performance.now();
      counters.forEach((el) => (el.textContent = '0'));
      const tick = (now: number) => {
        if (id !== runId) return counters.forEach((el) => (el.textContent = el.dataset.count!)); // another card took over
        let busy = false;
        for (const el of counters) {
          const t = Math.min(Math.max((now - start - Number(el.dataset.at)) / Number(el.dataset.for), 0), 1);
          el.textContent = String(Math.round(Number(el.dataset.count) * easeOut(t)));
          if (t < 1) busy = true;
        }
        if (busy) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    // Replays start once the section is on screen, so the first one isn't over before anyone sees it.
    let seen = false;
    let current = -1;
    const activate = (i: number) => {
      if (i === current) return;
      current = i;
      items.forEach((li, j) => li.toggleAttribute('data-active', j === i));
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === i)));
      count.textContent = `${i + 1} / ${items.length}`;
      if (seen) run(cards[i]);
    };
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen = true;
        run(cards[Math.max(current, 0)]);
        observer.disconnect();
      },
      { threshold: 0.35 },
    ).observe(list);

    /* Desktop: panels open on hover (after a short pause, so sweeping across doesn't flicker) or focus. */
    let pending: number | undefined;
    tiles.forEach((tile, i) => {
      tile.addEventListener('pointerenter', (e) => {
        if (!desk.matches || e.pointerType !== 'mouse') return;
        clearTimeout(pending);
        pending = window.setTimeout(() => activate(i), 120);
      });
      tile.addEventListener('pointerleave', () => clearTimeout(pending));
      tile.addEventListener('focus', () => {
        if (desk.matches) activate(i);
      });
      // A touch screen at desktop width has no hover: the first tap opens the panel, the next follows the link.
      tile.addEventListener('click', (e) => {
        if (desk.matches && current !== i) {
          e.preventDefault();
          activate(i);
        }
      });
    });

    /* Phones: the card nearest the middle is in focus; the others shrink a little. No fade: it
       pushed the side cards' small report text below 4.5:1 contrast. */
    const paint = () => {
      const box = list.getBoundingClientRect();
      const mid = box.left + box.width / 2;
      let best = 0;
      let bestD = Infinity;
      cards.forEach((card, i) => {
        const r = items[i].getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid) / r.width;
        if (d < bestD) {
          bestD = d;
          best = i;
        }
        const k = Math.min(d, 1);
        card.style.transform = reduced.matches ? '' : `scale(${1 - k * 0.08})`;
      });
      return best;
    };
    let settle: number | undefined;
    list.addEventListener(
      'scroll',
      () => {
        if (desk.matches) return;
        requestAnimationFrame(paint);
        clearTimeout(settle);
        settle = window.setTimeout(() => activate(paint()), 90);
      },
      { passive: true },
    );
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        const item = items[i].getBoundingClientRect();
        const box = list.getBoundingClientRect();
        const left = list.scrollLeft + (item.left - box.left) - (box.width - item.width) / 2;
        list.scrollTo({ left, behavior: reduced.matches ? 'auto' : 'smooth' });
      }),
    );
    // Keyboard on a phone layout: a focused card scrolls itself to the middle.
    tiles.forEach((tile, i) =>
      tile.addEventListener('focus', () => {
        if (!desk.matches) dots[i].click();
      }),
    );

    const layout = () => {
      if (desk.matches) cards.forEach((c) => (c.style.transform = ''));
      else paint();
    };
    desk.addEventListener('change', layout);
    activate(0);
    layout();
  }
</script>

<style>
  .work-index {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 720;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .section-lede {
    margin-top: 12px;
    max-width: 60ch;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.15rem);
    color: var(--ink-2);
  }
  .anchor {
    position: absolute;
  }
  .track {
    margin: clamp(28px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    position: relative;
    display: block;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
  }

  /* The card (same anatomy everywhere) */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 18px;
    background: var(--card);
    box-shadow: 0 24px 48px -28px rgb(20 20 18 / 0.4);
  }
  .card-top {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 18px 18px 0;
    background: var(--accent, var(--qa-panel));
    overflow: hidden;
  }
  .card-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    border-radius: 10px 10px 0 0;
    align-self: end;
  }
  .card-body {
    display: grid;
    gap: 4px;
    padding: 16px 20px 20px;
  }
  .card-kind {
    order: -1;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card-title {
    font-size: 1.5rem;
    font-weight: 720;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .card-stat {
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--pass);
  }
  .card-cta {
    display: inline-flex;
    gap: 6px;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink);
  }
  .cta-arrow {
    color: var(--pass);
    transition: transform 200ms var(--ease-out);
  }
  .tile:focus-visible .cta-arrow {
    transform: translateX(4px);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover .cta-arrow {
      transform: translateX(4px);
    }
  }

  /* QA cards: the real test report instead of a screenshot (the products can't be shown). */
  .report {
    align-self: stretch;
    display: grid;
    align-content: start;
    gap: 9px;
    width: 100%;
    padding: 16px;
    border-radius: 10px 10px 0 0;
    /* Text colours are deep enough for 4.5:1 at this small size on both papers
       (light #e9e8e1 and the darker dark-mode #cfcdc3). */
    --report-dim: #4f4e47;
    --report-pass: #0e5c3c;
    --report-fail: #9a2019;
    background: var(--report-paper);
    color: #151513;
    font-family: var(--mono);
    font-size: 0.74rem;
  }
  .report-title {
    padding-bottom: 8px;
    border-bottom: 1px dashed #bdb9ab;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--report-dim);
  }
  .report-line {
    display: flex;
    gap: 8px;
  }
  .report-line .tick {
    color: var(--report-pass);
    font-weight: 700;
  }
  .bar {
    display: grid;
    gap: 3px;
    height: 11px;
  }
  .bar span {
    border-radius: 3px;
  }
  .bar-pass {
    background: #15744a;
  }
  .bar-fail {
    background: #b3261e;
  }
  .legend {
    justify-content: space-between;
  }
  .legend .pass {
    color: var(--report-pass);
  }
  .legend .fail,
  .bug-id {
    color: var(--report-fail);
  }
  .bug-id {
    font-weight: 600;
  }
  .bug {
    flex-direction: column;
    gap: 2px;
    padding-top: 8px;
    border-top: 1px dashed #bdb9ab;
  }
  .summary {
    padding-top: 8px;
    border-top: 1px dashed #bdb9ab;
    color: var(--report-pass);
    font-weight: 600;
  }

  /* Website cards: a Lighthouse run over the screenshot (real mobile scores from profile.ts). */
  .lh {
    position: absolute;
    left: 18px;
    bottom: 16px;
    display: grid;
    gap: 5px;
    width: min(250px, calc(100% - 36px));
    padding: 12px 14px;
    border-radius: 10px;
    background: #151513;
    box-shadow: 0 16px 32px -16px rgb(0 0 0 / 0.6);
    color: var(--term-text);
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .lh-cmd {
    margin-bottom: 3px;
    color: var(--term-dim);
  }
  .lh-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 8px;
  }
  .lh-score {
    color: var(--term-pass);
    font-variant-numeric: tabular-nums;
  }
  .lh .tick {
    color: var(--term-pass);
  }

  /* Pending dot that turns into a tick, stacked in one cell. */
  .mark {
    display: grid;
    width: 1ch;
  }
  .mark > * {
    grid-area: 1 / 1;
  }
  .pend {
    opacity: 0;
  }

  /* The replay. Without .is-running (or with reduced motion) everything shows its final state. */
  @media (prefers-reduced-motion: no-preference) {
    .is-running .step {
      animation: step-in 300ms var(--ease-out) both;
      animation-delay: var(--at, calc(150ms + var(--i, 0) * 140ms));
    }
    .is-running .lh {
      animation: step-in 320ms var(--ease-out) both;
    }
    .is-running .mark .pend {
      animation: pend-out 1ms linear both;
      animation-delay: var(--done);
    }
    .is-running .mark .tick {
      animation: tick-in 260ms var(--ease-out) both;
      animation-delay: var(--done);
    }
    .is-running .fill {
      animation: bar-fill 900ms var(--ease-out) both;
      animation-delay: 150ms;
    }
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }
  @keyframes pend-out {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes tick-in {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }
  @keyframes bar-fill {
    from {
      clip-path: inset(0 100% 0 0 round 3px);
    }
    to {
      clip-path: inset(0 0 0 0 round 3px);
    }
  }

  .track-ctrl {
    display: none;
  }
  .dots {
    display: flex;
    gap: 2px;
  }
  .dots button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dots button::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--ink-3);
    opacity: 0.55;
    transition:
      width 220ms var(--ease-out),
      background-color 220ms ease;
  }
  .dots button[aria-current='true']::before {
    width: 20px;
    background: var(--ink);
    opacity: 1;
  }

  /* ---------- Desktop: expanding panels ---------- */
  @media (min-width: 961px) {
    .track {
      display: flex;
      gap: 10px;
      height: 460px;
    }
    .track li {
      flex: 1 1 0;
      min-width: 0;
      transition: flex-grow 560ms var(--ease-out);
    }
    .track li[data-active] {
      flex-grow: 6;
    }
    .tile {
      overflow: hidden;
      border-radius: 18px;
      background: var(--accent, var(--qa-panel));
      box-shadow: inset 0 0 0 1px var(--edge);
    }
    .tile:focus-visible {
      outline: 3px solid var(--pass);
      outline-offset: 3px;
    }
    .tile-label {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding: 22px 0;
      color: #fff;
      transition: opacity 200ms ease;
    }
    .tile-title {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 1.2rem;
      font-weight: 720;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }
    .track li[data-active] .tile-label {
      opacity: 0;
    }
    .card {
      position: absolute;
      inset: 0;
      opacity: 0;
      box-shadow: none;
      transition: opacity 240ms ease;
    }
    .track li[data-active] .card {
      opacity: 1;
      transition-delay: 220ms;
    }
    @media (hover: hover) and (pointer: fine) {
      .track li:not([data-active]) .tile:hover .tile-label {
        background: rgb(255 255 255 / 0.08);
      }
    }
  }

  /* ---------- Phones and tablets: snap carousel ---------- */
  @media (max-width: 960px) {
    .track {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      margin-inline: calc(-1 * var(--gutter));
      /* Half the leftover width on each side, so the first and last cards can centre too. */
      padding-inline: calc((100vw - min(82vw, 440px)) / 2);
      padding-block: 4px 12px;
      scrollbar-width: none;
    }
    .track::-webkit-scrollbar {
      display: none;
    }
    .track li {
      flex: 0 0 min(82vw, 440px);
      scroll-snap-align: center;
    }
    .tile-label {
      display: none;
    }
    .card {
      height: 440px;
      transform-origin: center;
      will-change: transform;
    }
    .tile:focus-visible {
      outline: none;
    }
    .tile:focus-visible .card {
      outline: 3px solid var(--pass);
      outline-offset: 3px;
    }
    .track-ctrl {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 6px;
    }
    .track-count {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--ink-3);
      font-variant-numeric: tabular-nums;
    }
  }
  /* Narrow cards: tighter report text so the seven MoneyGuard flows fit on one line each. */
  @media (max-width: 600px) {
    .card-top {
      padding: 14px 14px 0;
    }
    .report {
      gap: 7px;
