---
// The homepage's Work section. Desktop: the list beside one preview card that crossfades to the
// hovered or focused project. Phones: just the list, with a thumbnail per project.
// Every row (and the preview) opens the project's case study page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/profile';
import { caseStudies } from '../data/case-studies';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const shot = (p: Project) => p.shots && shots[`../assets/work/${p.shots}-desktop.jpg`]?.default;
// Projects with a case study open their own page; the rest jump to their section below.
const href = (p: Project) => (caseStudies[p.slug] ? `/work/${p.slug}` : `#${p.slug}`);
---

<section id="work" class="work-index wrap section-rule" aria-labelledby="work-title">
  {/* The old Websites and QA sections lived here; links shared before still land on the work. */}
  <span id="websites" class="anchor" aria-hidden="true"></span>
  <span id="qa" class="anchor" aria-hidden="true"></span>
  <div class="section-head" data-reveal>
    <h2 id="work-title">Work</h2>
    <p class="section-lede">
      What I've built and tested. Each opens its case study<span class="hint-desk">; hover one to preview it</span>.
    </p>
  </div>

  <div class="index-layout">
    <ol class="index-list" data-index-list>
      {
        projects.map((p, i) => (
          <li>
            <a href={href(p)} data-index={i}>
              <span class="row-thumb" aria-hidden="true" style={p.accent ? `--accent:${p.accent}` : undefined}>
                {shot(p) ? (
                  <Image src={shot(p)!} alt="" widths={[96, 192]} sizes="64px" />
                ) : (
                  <svg viewBox="0 0 24 24">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                )}
              </span>
              <span class="row-main">
                <span class="row-title">{p.title}</span>
                <span class="row-kind">{p.kind}</span>
              </span>
              {p.stat && <span class="row-proof">{p.stat}</span>}
            </a>
          </li>
        ))
      }
    </ol>

    <div class="stack" data-stack>
      {
        projects.map((p, i) => {
          const img = shot(p);
          return (
            <a
              class:list={['card', p.group === 'qa' ? 'card-qa' : 'card-web']}
              href={href(p)}
              data-card={i}
              style={p.accent ? `--accent:${p.accent}` : undefined}
            >
              <span class="card-top">
                {img ? (
                  <>
                    <Image src={img} alt="" widths={[360, 720]} sizes="(min-width: 961px) 480px, 1px" class="card-shot" />
                    {p.scores && (
                      <span class="lh" aria-hidden="true">
                        <span class="lh-cmd">$ lighthouse {p.link?.label ?? p.title}</span>
                        {p.scores.values.map((s, k) => (
                          <span class="lh-row step" style={`--i:${k}`}>
                            <span class="mark" style={`--done:${k * 140 + 640}ms`}>
                              <span class="pend">·</span>
                              <span class="tick">✓</span>
                            </span>
                            <span class="lh-label">{s.label}</span>
                            <span class="lh-score" data-count={s.value} data-at={k * 140 + 150} data-for="520">
                              {s.value}
                            </span>
                          </span>
                        ))}
                      </span>
                    )}
                  </>
                ) : (
                  <span class="report" aria-hidden="true">
                    <span class="report-title">{p.results ? 'Test report' : 'Release checklist'}</span>
                    {p.results ? (
                      <>
                        <span class="report-line">
                          {p.results.label}:{' '}
                          <span data-count={p.results.passed + p.results.failed} data-at="150" data-for="900">
                            {p.results.passed + p.results.failed}
                          </span>{' '}
                          test cases
                        </span>
                        <span class="bar fill" style={`grid-template-columns:${p.results.passed}fr ${p.results.failed}fr`}>
                          <span class="bar-pass" />
                          <span class="bar-fail" />
                        </span>
                        <span class="report-line legend step" style="--at:1050ms">
                          <span class="pass">{p.results.passed} passed</span>
                          <span class="fail">{p.results.failed} failed</span>
                        </span>
                        {p.bugs?.map((b, k) => (
                          <span class="report-line bug step" style={`--at:${1250 + k * 180}ms`}>
                            <span>
                              <span class="bug-id">{b.id}</span> · {b.severity}
                            </span>
                            <span>{b.title}</span>
                          </span>
                        ))}
                      </>
                    ) : (
                      <>
                        {(p.checks ?? []).map((c, k) => (
                          <span class="report-line step" style={`--i:${k}`}>
                            <span class="mark" style={`--done:${k * 140 + 360}ms`}>
                              <span class="pend">·</span>
                              <span class="tick">✓</span>
                            </span>
                            {c}
                          </span>
                        ))}
                        <span class="report-line summary step" style={`--at:${(p.checks?.length ?? 0) * 140 + 450}ms`}>
                          {p.checks?.length}/{p.checks?.length} {(p.checksLabel ?? 'checks').toLowerCase()}
                        </span>
                      </>
                    )}
                  </span>
                )}
              </span>
              <span class="card-body">
                <span class="card-kind">{p.kind}</span>
                <span class="card-title">{p.title}</span>
                {p.stat && <span class="card-stat">{p.stat}</span>}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-index-list]');
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (list && stack) {
    const rows = [...list.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const cards = [...stack.querySelectorAll<HTMLAnchorElement>('[data-card]')];

    // Each card replays its checks when it comes up: rows step in and tick (CSS, under
    // .is-running), and numbers count up to the real result (below). Reduced motion skips the
    // replay; the markup already holds the final results.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    let runId = 0;
    const run = (card: HTMLElement) => {
      if (reduced.matches) return;
      const id = ++runId;
      card.classList.remove('is-running');
      void card.offsetWidth; // restart the CSS animations
      card.classList.add('is-running');
      const counters = [...card.querySelectorAll<HTMLElement>('[data-count]')];
      const start = performance.now();
      counters.forEach((el) => (el.textContent = '0'));
      const tick = (now: number) => {
        if (id !== runId) return; // another card took over
        let busy = false;
        for (const el of counters) {
          const target = Number(el.dataset.count);
          const t = Math.min(Math.max((now - start - Number(el.dataset.at)) / Number(el.dataset.for), 0), 1);
          el.textContent = String(Math.round(target * easeOut(t)));
          if (t < 1) busy = true;
        }
        if (busy) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    // Runs start once the preview is on screen, so the first card isn't over before anyone sees it.
    let seen = false;
    let current = -1;
    const show = (index: number) => {
      if (index === current) return;
      current = index;
      rows.forEach((row, i) => row.classList.toggle('is-active', i === index));
      cards.forEach((card, i) => card.toggleAttribute('data-active', i === index));
      if (seen) run(cards[index]);
    };
    new IntersectionObserver((entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      seen = true;
      run(cards[current]);
      observer.disconnect();
    }, { threshold: 0.4 }).observe(stack);

    // Only switch once the pointer settles on a row: on the way across to the preview it passes
    // over other rows, and switching on every one would swap the card out from under the click.
    let pending: number | undefined;
    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => {
        clearTimeout(pending);
        pending = window.setTimeout(() => show(i), 90);
      });
      row.addEventListener('pointerleave', () => clearTimeout(pending));
      row.addEventListener('focus', () => show(i));
    });
    // The list carries the same links, so screen readers and Tab skip the preview; the mouse can still click it.
    cards.forEach((card) => {
      card.setAttribute('aria-hidden', 'true');
      card.tabIndex = -1;
    });
    show(0);
  }
</script>

<style>
  .work-index {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 720;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .section-lede {
    margin-top: 12px;
    max-width: 60ch;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.15rem);
    color: var(--ink-2);
  }

  .index-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    margin-top: clamp(28px, 4vw, 48px);
  }

  /* The list */
  .index-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .anchor {
    position: absolute;
  }
  .index-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 18px 14px;
    margin-inline: -14px;
    border-radius: 10px;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .index-list li {
    border-bottom: 1px solid var(--line);
  }
  .row-title {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .row-main {
    display: grid;
    gap: 2px;
  }
  .row-kind {
    color: var(--ink-3);
    font-size: 0.92rem;
  }
  .row-proof {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--pass);
    white-space: nowrap;
  }
  .row-thumb {
    display: none;
  }
  .index-list a.is-active {
    background: var(--paper-2);
  }

  /* The preview: every card sits in the same spot; only the active one shows. */
  .stack {
    position: relative;
    height: 460px;
  }
  .card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 320ms var(--ease-out);
    overflow: hidden;
    border-radius: 16px;
    background: var(--card);
    box-shadow: 0 24px 48px -28px rgb(20 20 18 / 0.4);
    color: var(--ink);
    text-decoration: none;
  }
  .card[data-active] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transform: none;
      transition: opacity 120ms ease;
    }
  }
  .card-top {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 18px 18px 0;
    background: var(--accent, var(--term));
    overflow: hidden;
  }
  .card-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    border-radius: 10px 10px 0 0;
    align-self: end;
  }
  .card-body {
    display: grid;
    gap: 4px;
    padding: 16px 20px 20px;
  }
  .card-kind {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card-title {
    font-size: 1.5rem;
    font-weight: 720;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .card-stat {
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--pass);
  }

  /* QA cards: the real test report instead of a screenshot (the products can't be shown). */
  .report {
    align-self: stretch;
    display: grid;
    align-content: start;
    gap: 9px;
    width: 100%;
    padding: 16px;
    border-radius: 10px 10px 0 0;
    background: var(--term-text);
    color: #151513;
    font-family: var(--mono);
    font-size: 0.74rem;
  }
  .report-title {
    padding-bottom: 8px;
    border-bottom: 1px dashed #bdb9ab;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #66655c;
  }
  .report-line {
    display: flex;
    gap: 8px;
  }
  .report-line .tick {
    color: #15744a;
    font-weight: 700;
  }
  .bar {
    display: grid;
    gap: 3px;
    height: 11px;
  }
  .bar span {
    border-radius: 3px;
  }
  .bar-pass {
    background: #15744a;
  }
  .bar-fail {
    background: #b3261e;
  }
  .legend {
    justify-content: space-between;
  }
  .legend .pass {
    color: #15744a;
  }
  .legend .fail,
  .bug-id {
    color: #b3261e;
  }
  .bug-id {
    font-weight: 600;
  }
  .bug {
    flex-direction: column;
    gap: 2px;
    padding-top: 8px;
    border-top: 1px dashed #bdb9ab;
  }

  .summary {
    padding-top: 8px;
    border-top: 1px dashed #bdb9ab;
    color: #15744a;
    font-weight: 600;
  }

  /* Website cards: a Lighthouse run over the screenshot (real mobile scores from profile.ts). */
  .card-top {
    position: relative;
  }
  .lh {
    position: absolute;
    left: 18px;
    bottom: 16px;
    display: grid;
    gap: 5px;
    width: min(250px, calc(100% - 36px));
    padding: 12px 14px;
    border-radius: 10px;
    background: #151513;
    box-shadow: 0 16px 32px -16px rgb(0 0 0 / 0.6);
    color: var(--term-text);
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .lh-cmd {
    margin-bottom: 3px;
    color: var(--term-dim);
  }
  .lh-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 8px;
  }
  .lh-score {
    color: var(--term-pass);
    font-variant-numeric: tabular-nums;
  }
  .lh .tick {
    color: var(--term-pass);
  }

  /* Pending dot that turns into a tick, stacked in one cell. */
  .mark {
    display: grid;
    width: 1ch;
  }
  .mark > * {
    grid-area: 1 / 1;
  }
  .pend {
    opacity: 0;
    color: currentColor;
  }

  /* The replay. Without .is-running (or with reduced motion) everything shows its final state. */
  @media (prefers-reduced-motion: no-preference) {
    .is-running .step {
      animation: step-in 300ms var(--ease-out) both;
      animation-delay: var(--at, calc(150ms + var(--i, 0) * 140ms));
    }
    .is-running .lh {
      animation: step-in 320ms var(--ease-out) both;
    }
    .is-running .mark .pend {
      animation: pend-out 1ms linear both;
      animation-delay: var(--done);
    }
    .is-running .mark .tick {
      animation: tick-in 260ms var(--ease-out) both;
      animation-delay: var(--done);
    }
    .is-running .fill {
      animation: bar-fill 900ms var(--ease-out) both;
      animation-delay: 150ms;
    }
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }
  @keyframes pend-out {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes tick-in {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }
  @keyframes bar-fill {
    from {
      clip-path: inset(0 100% 0 0 round 3px);
    }
    to {
      clip-path: inset(0 0 0 0 round 3px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .index-list a:hover {
      background: var(--paper-2);
    }
  }

  /* Phones and tablets: no list, the cards become a row you swipe through. */
  /* Phones and tablets: just the list, each row with a thumbnail and its proof figure. */
  @media (max-width: 960px) {
    .hint-desk {
      display: none;
    }
    .index-layout {
      display: block;
    }
    .stack {
      display: none;
    }
    .index-list a {
      grid-template-columns: 64px minmax(0, 1fr);
      grid-template-areas:
        'thumb main'
        'thumb proof';
      align-items: start;
      gap: 4px 16px;
      padding: 14px 12px;
      margin-inline: -12px;
    }
    .row-thumb {
      grid-area: thumb;
      display: grid;
      place-items: center;
      width: 64px;
      height: 64px;
      overflow: hidden;
      border-radius: 12px;
      background: var(--accent, var(--term));
    }
    .row-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      transform: scale(1.15) translate(6%, 6%);
    }
    .row-thumb svg {
      width: 28px;
      height: 28px;
      fill: none;
      stroke: var(--term-pass);
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .row-main {
      grid-area: main;
    }
    .row-proof {
      grid-area: proof;
      white-space: normal;
    }
  }
</style>
