---
// Two quick questions about the site, shown once a bug hunt game ends (BugHunt dispatches
// "bughunt:over"). Answers go straight to Firestore over its REST API (no SDK): collection
// "feedback" in the daniel-iyoha project, write-only under firestore.rules. Whatever the visitor
// does (sends, skips or says not now) is remembered, so the card never asks twice.
import type { Lang } from '../i18n';
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const scale = [1, 2, 3, 4, 5];
const t = {
  en: {
    kicker: 'Quick question',
    of: 'of',
    notNow: 'Not now',
    q1: 'How easy was it to find what you needed on this site?',
    hint1: '1 is frustrating, 5 is effortless.',
    next: 'Next',
    q2: 'Anything broken or confusing?',
    hint2: 'Report it like a bug: what you did and what happened. Optional.',
    skip: 'Skip',
    send: 'Send',
    done: 'Logged. Thank you for testing my site.',
    error: "That didn't send. Check your connection and try again.",
  },
  de: {
    kicker: 'Kurze Frage',
    of: 'von',
    notNow: 'Jetzt nicht',
    q1: 'Wie leicht haben Sie auf dieser Website gefunden, was Sie gesucht haben?',
    hint1: '1 ist frustrierend, 5 ist mühelos.',
    next: 'Weiter',
    q2: 'Ist etwas kaputt oder unklar?',
    hint2: 'Melden Sie es wie einen Bug: was Sie getan haben und was passiert ist. Optional.',
    skip: 'Überspringen',
    send: 'Senden',
    done: 'Gespeichert. Danke, dass Sie meine Website getestet haben.',
    error: 'Das wurde nicht gesendet. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut.',
  },
}[lang];
---

<div class="fb" data-feedback hidden>
  <div class="fb-head">
    <p class="fb-kicker">{t.kicker} · <span data-fb-step>1</span> {t.of} 2</p>
    <button type="button" class="fb-close" data-fb-dismiss aria-label={t.notNow}>×</button>
  </div>

  <form data-fb-form novalidate>
    <fieldset class="fb-step" data-fb-panel="1">
      <legend class="fb-q">{t.q1}</legend>
      <p class="fb-hint" id="fb-scale-hint">{t.hint1}</p>
      <div class="fb-scale" aria-describedby="fb-scale-hint">
        {
          scale.map((n) => (
            <label>
              <input type="radio" name="ease" value={n} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
      <div class="fb-actions">
        <button type="button" class="fb-quiet" data-fb-dismiss>{t.notNow}</button>
        <button type="button" class="fb-go" data-fb-next disabled>{t.next}</button>
      </div>
    </fieldset>

    <div class="fb-step" data-fb-panel="2" hidden>
      <label class="fb-q" for="fb-note">{t.q2}</label>
      <p class="fb-hint">{t.hint2}</p>
      <textarea id="fb-note" name="note" rows="3" maxlength="1000"></textarea>
      <div class="fb-actions">
        <button type="button" class="fb-quiet" data-fb-skip>{t.skip}</button>
        <button type="submit" class="fb-go" data-fb-send>{t.send}</button>
      </div>
    </div>
  </form>

  <p class="fb-done" data-fb-done hidden tabindex="-1">{t.done}</p>
  <p class="fb-error" data-fb-error role="alert" hidden>{t.error}</p>
</div>

<script>
  const ENDPOINT = 'https://firestore.googleapis.com/v1/projects/daniel-iyoha/databases/(default)/documents:commit';
  const KEY = 'site-feedback';

  const card = document.querySelector<HTMLElement>('[data-feedback]');
  if (card) {
    const $ = <T extends HTMLElement>(sel: string) => card.querySelector<T>(sel)!;
    const form = $<HTMLFormElement>('[data-fb-form]');
    const next = $<HTMLButtonElement>('[data-fb-next]');
    const send = $<HTMLButtonElement>('[data-fb-send]');
    const note = $<HTMLTextAreaElement>('#fb-note');

    const answered = () => {
      try {
        return !!localStorage.getItem(KEY);
      } catch {
        return false;
      }
    };
    const remember = (value: string) => {
      try {
        localStorage.setItem(KEY, value);
      } catch {}
    };

    const showStep = (n: 1 | 2) => {
      $('[data-fb-step]').textContent = String(n);
      $('[data-fb-panel="1"]').hidden = n !== 1;
      $('[data-fb-panel="2"]').hidden = n !== 2;
      if (n === 2) note.focus();
    };

    document.addEventListener('bughunt:over', () => {
      if (answered() || !card.hidden) return;
      // A beat after the result, so the score is read first.
      setTimeout(() => (card.hidden = false), 900);
    });

    card.querySelectorAll('[data-fb-dismiss]').forEach((b) =>
      b.addEventListener('click', () => {
        remember('dismissed');
        card.hidden = true;
      }),
    );

    form.addEventListener('change', () => {
      next.disabled = !form.querySelector('input[name="ease"]:checked');
    });
    next.addEventListener('click', () => showStep(2));

    const device = () => (innerWidth < 600 ? 'phone' : innerWidth < 1024 ? 'tablet' : 'desktop');

    const submit = async (withNote: boolean) => {
      const ease = Number(form.querySelector<HTMLInputElement>('input[name="ease"]:checked')?.value);
      const text = withNote ? note.value.trim().slice(0, 1000) : '';
      const fields: Record<string, unknown> = { device: { stringValue: device() } };
      if (ease) fields.ease = { integerValue: String(ease) };
      if (text) fields.note = { stringValue: text };
      const id = crypto.randomUUID().replaceAll('-', '');
      const body = {
        writes: [
          {
            update: { name: `projects/daniel-iyoha/databases/(default)/documents/feedback/${id}`, fields },
            // No "must not exist" precondition: checking it needs read access, which the rules deny.
            // The id is random, and the rules refuse updates, so nothing can be overwritten.
            updateTransforms: [{ fieldPath: 'createdAt', setToServerValue: 'REQUEST_TIME' }],
          },
        ],
      };
      send.disabled = true;
      $('[data-fb-error]').hidden = true;
      try {
        const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) throw new Error(String(res.status));
        remember('sent');
        form.hidden = true;
        $('[data-fb-step]').parentElement!.hidden = true;
        const done = $('[data-fb-done]');
        done.hidden = false;
        done.focus();
      } catch {
        $('[data-fb-error]').hidden = false;
      } finally {
        send.disabled = false;
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submit(true);
    });
    $('[data-fb-skip]').addEventListener('click', () => submit(false));
  }
</script>

<style>
  .fb {
    margin-top: 20px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    animation: fb-in 260ms var(--ease-out);
  }
  .fb[hidden] {
    display: none;
  }
  @keyframes fb-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fb {
      animation: none;
    }
  }
  .fb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .fb-head[hidden] {
    display: none;
  }
  .fb-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fb-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: -10px -10px -10px 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    font-size: 1.3rem;
    cursor: pointer;
  }
  .fb-step {
    margin: 10px 0 0;
    padding: 0;
    border: 0;
  }
  .fb-step[hidden] {
    display: none;
  }
  .fb-q {
    display: block;
    padding: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .fb-hint {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .fb-scale {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin-top: 14px;
  }
  .fb-scale label {
    position: relative;
  }
  .fb-scale input {
    position: absolute;
    z-index: 1;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .fb-scale span {
    display: grid;
    place-items: center;
    min-height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    font-family: var(--mono);
    font-weight: 500;
    color: var(--ink-2);
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .fb-scale input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .fb-scale input:focus-visible + span {
    outline: 2px solid var(--pass);
    outline-offset: 2px;
  }
  .fb-scale input:active + span {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .fb-scale input:not(:checked):hover + span {
      background: var(--paper-2);
    }
  }
  textarea {
    width: 100%;
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    resize: vertical;
  }
  textarea:focus-visible {
    outline: 2px solid var(--pass);
    outline-offset: 1px;
  }
  .fb-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }
  .fb-quiet,
  .fb-go {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .fb-quiet {
    border: 0;
    background: transparent;
    color: var(--ink-2);
    padding-left: 0;
  }
  .fb-go {
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    transition: opacity 150ms ease;
  }
  .fb-go:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .fb-done {
    font-weight: 600;
    color: var(--pass);
  }
  .fb-done:focus {
    outline: none;
  }
  .fb-error {
    margin-top: 10px;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .fb-error::before {
    content: '✗ ';
    color: #d64b3b;
    font-weight: 700;
  }
</style>
