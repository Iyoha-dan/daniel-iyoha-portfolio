---
// A short way to get in touch at the end of a project page, where a visitor is most convinced.
import { person } from '../data/profile';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <div>
      <h2 id="cta-title">Hiring a tester, or need a website that looks good and works well on every device?</h2>
      <p class="cta-more">Running a business? <a href="/websites">See how I build websites →</a></p>
    </div>
    <div class="cta-actions">
      <a class="cta-primary" href={`mailto:${person.email}`}>Email me</a>
      <a href={person.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
      {person.cv && <a href="/cv">View CV →</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--term);
    color: var(--term-text);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 24px 48px;
    padding-block: clamp(40px, 6vw, 72px);
  }
  h2 {
    max-width: 24ch;
    font-size: clamp(1.4rem, 1.1rem + 1.3vw, 2.1rem);
    font-weight: 720;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .cta-more {
    margin-top: 12px;
    color: var(--term-dim);
  }
  .cta-more a {
    color: var(--term-text);
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .cta-actions .cta-primary {
    background: var(--term-pass);
    border-color: var(--term-pass);
    color: #0b0b0a;
    font-weight: 500;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta-actions a:not(.cta-primary):hover {
      background: var(--term-text);
      color: var(--term);
    }
  }
  @media (max-width: 860px) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
