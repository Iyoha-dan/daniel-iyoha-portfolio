---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Testimonial } from '../data/profile';

interface Props {
  items: Testimonial[];
}
const { items } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/people/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = (file?: string) => file && photos[`../assets/people/${file}`]?.default;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .slice(0, 2)
    .join('');

// With several quotes, the longest leads as a larger card and the rest stack beside it,
// so a long quote doesn't leave the short ones mostly empty.
const featured = items.length > 1 ? items.reduce((a, b) => (b.quote.length > a.quote.length ? b : a)) : undefined;
const ordered = featured ? [featured, ...items.filter((t) => t !== featured)] : items;

// Splits a quote around its optional highlight phrase (the words stay exactly as given).
const parts = (t: Testimonial) => {
  const at = t.highlight ? t.quote.indexOf(t.highlight) : -1;
  if (at < 0) return { before: t.quote, mark: '', after: '' };
  return { before: t.quote.slice(0, at), mark: t.highlight!, after: t.quote.slice(at + t.highlight!.length) };
};
---

{
  items.length > 0 && (
    <section id="testimonials" class="testimonials wrap section-rule" aria-labelledby="testimonials-title">
      <div class="section-head" data-reveal>
        <h2 id="testimonials-title">What people say</h2>
      </div>
      <div class:list={['quotes', { single: items.length === 1, multi: items.length > 1 }]}>
        {ordered.map((t) => {
          const img = photo(t.photo);
          const q = parts(t);
          return (
            <figure
              class:list={['quote', { featured: t === featured }]}
              style={t === featured ? `grid-row: span ${items.length - 1}` : undefined}
              data-reveal
            >
              <div class="quote-top">
                <span class="mark" aria-hidden="true">
                  &ldquo;
                </span>
                <span class="relation">{t.relation}</span>
              </div>
              <blockquote>
                <p>
                  {q.before}
                  {q.mark && <mark>{q.mark}</mark>}
                  {q.after}
                </p>
              </blockquote>
              <figcaption>
                {img ? (
                  <Image src={img} alt="" width={88} height={88} class="avatar" />
                ) : (
                  <span class="avatar initials" aria-hidden="true">
                    {initials(t.name)}
                  </span>
                )}
                <span class="who">
                  <span class="name">{t.name}</span>
                  <span class="role">
                    {t.role}, {t.company}
                  </span>
                </span>
              </figcaption>
              {t.link && (
                <a class="source" href={t.link} target="_blank" rel="noopener noreferrer">
                  Read the original <span aria-hidden="true">↗</span>
                </a>
              )}
            </figure>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .testimonials {
    padding-block: clamp(64px, 9vw, 120px);
  }
  .section-head h2 {
    margin-top: 0;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 720;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(32px, 5vw, 56px);
  }
  .quote {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(22px, 3vw, 32px);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  blockquote {
    flex: 1;
    margin: 0;
  }
  .quote-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    height: 38px;
    margin-bottom: 8px;
  }
  .mark {
    font-size: 3.4rem;
    font-weight: 800;
    line-height: 0.9;
    color: var(--pass);
  }
  blockquote p {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    text-wrap: pretty;
  }
  /* One quote: author on the left, the words on the right, so a long quote stays short. */
  .single blockquote p {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  }
  @media (min-width: 861px) {
    .single .quote {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      grid-template-areas:
        'top quote'
        'caption quote';
      grid-template-rows: auto 1fr;
      column-gap: 48px;
    }
    .single .quote-top {
      grid-area: top;
      height: auto;
      flex-direction: column;
      gap: 10px;
    }
    .single blockquote {
      grid-area: quote;
      max-width: 68ch;
    }
    .single figcaption {
      grid-area: caption;
      align-self: end;
      margin-top: 20px;
    }
  }
  .featured blockquote p {
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.5rem);
    letter-spacing: -0.01em;
  }
  .quotes.multi {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
  }
  .featured {
    height: 100%;
  }
  mark {
    background: linear-gradient(transparent 58%, var(--pass-tint) 58%);
    color: inherit;
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .quotes.multi {
      grid-template-columns: minmax(0, 1fr);
    }
    .featured {
      grid-row: auto !important;
    }
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--pass-tint);
    color: var(--pass);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .who {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }
  .name {
    font-weight: 650;
  }
  .role {
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .relation {
    margin-top: 4px;
    padding: 3px 10px;
    text-align: right;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-2);
  }
  .source {
    margin-top: 16px;
    font-size: 0.9rem;
    font-weight: 600;
    text-underline-offset: 4px;
    text-decoration-color: var(--line-strong);
  }
</style>
