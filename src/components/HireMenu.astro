---
// "Hiring?" in the header: pick what you're hiring for and get the three pieces of proof that
// matter for it, plus the right next step (CV, email or WhatsApp). Routes live in profile.ts.
// Switching routes is CSS only (:has on the checked radio); the script opens/closes the panel.
import { person, projects, hireRoutes } from '../data/profile';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);

// Size of this site's own test suite, from the last `npm test` run.
type Run = { stats: { expected: number; unexpected: number; flaky?: number } };
const runs = import.meta.glob<{ default: Run }>('../data/test-run.json', { eager: true });
const run = Object.values(runs)[0]?.default;
const testCount = run ? run.stats.expected + run.stats.unexpected + (run.stats.flaky ?? 0) : 0;

type Item = { href: string; title: string; proof: string };
const item = (slug: string, proof?: string): Item | undefined => {
  if (slug === 'tests') {
    return testCount ? { href: to('test-run'), title: 'The tests behind this site', proof: proof ?? `${testCount} tests run before every deploy` } : undefined;
  }
  if (slug === 'websites') {
    return { href: '/websites', title: 'How I build business websites', proof: proof ?? 'What you get, how it works, getting a quote' };
  }
  const p = projects.find((x) => x.slug === slug);
  return p && { href: `/work/${p.slug}`, title: p.title, proof: proof ?? p.stat ?? p.kind };
};
const routes = hireRoutes.map((r) => ({ ...r, items: r.picks.map((pick) => item(pick.slug, pick.proof)).filter((i): i is Item => !!i) }));
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<div class="hire" data-hire>
  <button class="hire-btn" type="button" aria-expanded="false" aria-controls="hire-panel" data-hire-toggle>
    Hiring?
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>

  <div class="hire-panel" id="hire-panel" role="group" aria-label="The short route" hidden data-hire-panel>
    <p class="hire-kicker">The short route</p>
    <fieldset class="hire-pick">
      <legend>I'm hiring for</legend>
      {
        routes.map((r, i) => (
          <label>
            <input type="radio" name="hire-route" value={r.id} checked={i === 0} />
            <span>{r.label}</span>
          </label>
        ))
      }
    </fieldset>

    {
      routes.map((r) => (
        <div class="hire-route" data-route={r.id}>
          <ul>
            {r.items.map((it) => (
              <li>
                <a href={it.href}>
                  <span class="hire-title">{it.title}</span>
                  <span class="hire-proof">{it.proof}</span>
                  <span class="hire-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="hire-actions">
            {r.primary === 'whatsapp' ? (
              <a class="solid" href={person.whatsappWebsite} {...external}>
                WhatsApp me ↗
              </a>
            ) : (
              person.cv && (
                <a class="solid" href={person.cv} download>
                  Download CV ↓
                </a>
              )
            )}
            <a href={`mailto:${person.email}`}>Email me</a>
          </div>
        </div>
      ))
    }

    <a class="hire-more" href={to('contact')}>All the ways to reach me →</a>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-hire]');
  const button = root?.querySelector<HTMLButtonElement>('[data-hire-toggle]');
  const panel = root?.querySelector<HTMLElement>('[data-hire-panel]');

  if (root && button && panel) {
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    button.addEventListener('click', () => setOpen(!isOpen()));

    // Close on Escape (focus back on the button), on a click outside, or when focus moves away.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) setOpen(false);
    });
    root.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !root.contains(next)) setOpen(false);
    });

    // Following a link closes the menu (matters for links within this page). The test-run link
    // also opens the panel, which starts collapsed on smaller screens.
    panel.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (!link) return;
      if (link.hash === '#test-run') document.getElementById('test-run')?.setAttribute('open', '');
      setOpen(false);
    });

    // Remember the visitor's pick for their next page.
    const radios = [...panel.querySelectorAll<HTMLInputElement>('input[name="hire-route"]')];
    try {
      const saved = localStorage.getItem('hire-route');
      const match = radios.find((r) => r.value === saved);
      if (match) match.checked = true;
    } catch {}
    for (const r of radios) {
      r.addEventListener('change', () => {
        try {
          localStorage.setItem('hire-route', r.value);
        } catch {}
      });
    }
  }
</script>

<style>
  .hire-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .hire-btn svg {
    transition: transform 200ms var(--ease-out);
  }
  .hire-btn[aria-expanded='true'] {
    background: var(--paper-2);
    border-color: var(--ink);
  }
  .hire-btn[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .hire-btn:hover {
      border-color: var(--ink);
    }
  }

  /* Drops from the header's right edge; .top-inner (SiteHeader) is the positioning box. */
  .hire-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: var(--gutter);
    width: min(400px, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - 88px);
    overflow-y: auto;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.35);
    transform-origin: top right;
    animation: hire-in 180ms var(--ease-out);
  }
  .hire-panel[hidden] {
    display: none;
  }
  @keyframes hire-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hire-panel,
    .hire-btn svg {
      animation: none;
      transition: none;
    }
  }

  .hire-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .hire-pick {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    border: 0;
  }
  .hire-pick legend {
    float: left;
    width: 100%;
    margin-bottom: 8px;
    font-weight: 600;
  }
  .hire-pick label {
    position: relative;
  }
  .hire-pick input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .hire-pick span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--ink-2);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .hire-pick input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .hire-pick input:focus-visible + span {
    outline: 2px solid var(--pass);
    outline-offset: 2px;
  }

  /* Only the route whose radio is checked shows. */
  .hire-route {
    display: none;
    margin-top: 14px;
  }
  .hire-panel:has(input[value='tester']:checked) [data-route='tester'],
  .hire-panel:has(input[value='developer']:checked) [data-route='developer'],
  .hire-panel:has(input[value='business']:checked) [data-route='business'] {
    display: block;
  }
  .hire-route ul {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hire-route li a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .hire-title {
    font-weight: 650;
  }
  .hire-proof {
    grid-column: 1;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--pass);
  }
  .hire-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-3);
    transition: transform 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hire-route li a:hover .hire-arrow {
      transform: translateX(3px);
      color: var(--ink);
    }
    .hire-route li a:hover .hire-title {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
  .hire-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .hire-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--ink);
  }
  .hire-actions a.solid {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .hire-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
</style>
