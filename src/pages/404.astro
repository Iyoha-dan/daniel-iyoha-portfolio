---
// Served by Firebase Hosting for any address that doesn't exist (dist/404.html).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { person, projects } from '../data/profile';
---

<Base title={`Page not found · ${person.name}`} description="This page doesn't exist. Head back to the work.">
  <SiteHeader />

  <main id="main" class="wrap lost">
    <p class="label">404</p>
    <h1>This page failed its test.</h1>

    <figure class="term">
      <pre><span class="x" aria-hidden="true">✗</span> GET <span data-path>this address</span>
  expected: a page
  received: 404 Not Found</pre>
    </figure>

    <p class="lede">The link may be old or mistyped. Everything I've built and tested is one click away.</p>

    <div class="actions">
      <a class="btn btn-solid" href="/#work">See my work</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </div>

    <nav class="projects" aria-label="Projects">
      <p class="label">Or go straight to a project</p>
      <ul>
        {
          projects.map((p) => (
            <li>
              <a href={`/work/${p.slug}`}>{p.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>

  <SiteFooter />
</Base>

<script>
  // Show the address that was asked for, as text only.
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = location.pathname;
</script>

<style>
  .lost {
    padding-block: clamp(40px, 8vw, 112px);
  }
  h1 {
    margin-top: 10px;
    max-width: 16ch;
    font-size: clamp(2.2rem, 1.4rem + 4vw, 4.2rem);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .term {
    margin: clamp(24px, 4vw, 40px) 0 0;
    max-width: 560px;
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--term);
    color: var(--term-text);
    overflow-x: auto;
  }
  .term pre {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.88rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .x {
    color: #ff8a7a;
  }
  .lede {
    margin-top: 24px;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .projects {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .projects ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }
  .projects a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .projects a:hover {
      background: var(--paper-2);
    }
  }
</style>
