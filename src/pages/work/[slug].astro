---
// One page per project with a case study (src/data/case-studies.ts): /work/<slug>.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import { person, projects, testimonials, type Project } from '../../data/profile';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
  const withPages = projects.filter((p) => caseStudies[p.slug]);
  return withPages.map((project, i) => {
    const n = (i + 1) % withPages.length;
    return {
      params: { slug: project.slug },
      props: { project, next: withPages[n], nextPosition: n + 1, total: withPages.length },
    };
  });
}

interface Props {
  project: Project;
  next: Project;
  nextPosition: number;
  total: number;
}
const { project: p, next, nextPosition, total: projectCount } = Astro.props;
const study = caseStudies[p.slug];
// QA report header: "63 cases · 2 bugs" when there are results, otherwise "7 flows verified".
const total = p.results ? p.results.passed + p.results.failed : 0;
const reportCount = p.results
  ? `${total} cases · ${p.bugs?.length ?? 0} bugs`
  : `${p.checks?.length ?? 0} ${(p.checksLabel ?? 'checks').toLowerCase()}`;
const quote = testimonials.find((t) => t.project === p.slug);

const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*.jpg', { eager: true });
const shot = (view: 'desktop' | 'mobile') => p.shots && shots[`../../assets/work/${p.shots}-${view}.jpg`]?.default;
const desktop = shot('desktop');
const mobile = shot('mobile');
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base title={`${p.title} · ${person.name}`} description={study.lede}>
  <SiteHeader />

  <main id="main">
    <article class="case" aria-labelledby="case-title">
      <header class="case-head wrap">
        <a class="back" href="/#work"><span aria-hidden="true">←</span> All work</a>
        <p class="label">{p.kind}</p>
        <h1 id="case-title">{p.title}</h1>
        <p class="lede">{study.lede}</p>
        <dl class="facts">
          {
            study.facts.map((f) => (
              <div>
                <dt class="label">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
          {
            p.link && (
              <div>
                <dt class="label">Live</dt>
                <dd>
                  <a href={p.link.href} {...external}>
                    {p.link.label} <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      <div class="case-visual wrap" style={p.accent ? `--accent:${p.accent}` : undefined}>
        {
          desktop ? (
            <div class="stage">
              <div class="browser">
                <div class="browser-bar" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                  <p>{p.link?.label}</p>
                </div>
                <Image src={desktop} alt={`${p.title} homepage on a desktop screen`} widths={[720, 1080, 1440]} sizes="(min-width: 1180px) 900px, 92vw" />
              </div>
              {mobile && (
                <div class="phone">
                  <Image src={mobile} alt={`${p.title} homepage on a phone`} widths={[240, 480]} sizes="220px" />
                </div>
              )}
            </div>
          ) : (
            <div class="stage stage-qa">
              <div class="report" data-report>
                <p class="report-head">
                  <span>{p.results ? 'Test report' : 'Release checklist'}</span>
                  <span>{reportCount}</span>
                </p>
                {p.results ? (
                  <div class="run">
                    <p class="run-title">
                      {p.results.label}: {total} test cases
                    </p>
                    <div class="bar" style={`grid-template-columns:${p.results.passed}fr ${p.results.failed}fr`} aria-hidden="true">
                      <span class="bar-pass" />
                      <span class="bar-fail" />
                    </div>
                    <p class="run-legend">
                      <span class="pass">{p.results.passed} passed</span>
                      <span class="fail">{p.results.failed} failed</span>
                    </p>
                  </div>
                ) : (
                  <ul class="flows">
                    {(p.checks ?? []).map((c) => (
                      <li>
                        <span class="tick" aria-hidden="true">
                          ✓
                        </span>
                        {c}
                      </li>
                    ))}
                  </ul>
                )}
                {p.bugs && (
                  <div class="bugs">
                    <p class="bugs-title">Bugs logged</p>
                    <ul>
                      {p.bugs.map((b) => (
                        <li class="ticket">
                          <span class="ticket-id">{b.id}</span>
                          <span class={`sev sev-${b.severity.toLowerCase()}`}>{b.severity}</span>
                          <span class="ticket-title">{b.title}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {p.note && <p class="report-note">{p.note}</p>}
              </div>
            </div>
          )
        }
      </div>

      <div class="case-body wrap">
        {
          study.sections.map((section) => (
            <section class="block">
              <h2>{section.heading}</h2>
              {section.paragraphs?.map((text) => (
                <p>{text}</p>
              ))}
              {section.list && (
                <ul class="points">
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.heading === 'How I checked it' && p.scores && (
                <div class="scores">
                  <ul aria-label={`Lighthouse scores on mobile, ${p.scores.date}`}>
                    {p.scores.values.map((s) => (
                      <li>
                        <span class="score-value" style={`--score:${s.value}`}>
                          {s.value}
                        </span>
                        <span class="score-label">{s.label}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="score-note">Lighthouse, mobile, live site · {p.scores.date}</p>
                </div>
              )}
            </section>
          ))
        }

        {
          p.outcome && !study.hideOutcome && (
            <section class="block">
              <h2>Outcome</h2>
              <p class="outcome">{p.outcome}</p>
            </section>
          )
        }

        {
          quote && (
            <figure class="quote">
              <blockquote>
                <p>{quote.quote}</p>
              </blockquote>
              <figcaption>
                <strong>{quote.name}</strong>
                <span>
                  {quote.role}, {quote.company}
                </span>
              </figcaption>
            </figure>
          )
        }

        {
          p.stack && (
            <section class="block">
              <h2>Built with</h2>
              <ul class="stack">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <nav class="next wrap" aria-label="Next project">
        <a href={`/work/${next.slug}`}>
          <span class="label">
            Next project <span class="next-count">· {nextPosition} of {projectCount}</span>
          </span>
          <span class="next-title">
            {next.title} <span aria-hidden="true">→</span>
          </span>
          <span class="next-kind">{next.kind}</span>
        </a>
      </nav>
    </article>
  </main>

  <ContactStrip />
  <SiteFooter />
</Base>

<style>
  .case-head {
    padding-top: clamp(32px, 5vw, 72px);
  }
  .back {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    margin-bottom: clamp(16px, 3vw, 32px);
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  @media (hover: hover) {
    .back:hover {
      color: var(--ink);
    }
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(2.4rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 22px;
    max-width: 62ch;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 20px 32px;
    margin: clamp(28px, 4vw, 44px) 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .facts dd {
    margin: 6px 0 0;
    font-weight: 550;
  }
  .facts a {
    text-underline-offset: 4px;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 18px 20px;
    }
  }

  /* The visual: a large screenshot on the project's colour, or a redacted report for QA work */
  .case-visual {
    margin-top: clamp(32px, 5vw, 64px);
  }
  .stage {
    position: relative;
    padding: clamp(24px, 5vw, 64px) clamp(24px, 8vw, 120px) clamp(48px, 7vw, 96px) clamp(16px, 5vw, 64px);
    border-radius: 20px;
    background: var(--accent, var(--paper-2));
    overflow: hidden;
  }
  .browser {
    background: var(--term);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px;
  }
  .browser-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .browser-bar p {
    margin-left: 10px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--term-dim);
  }
  .browser img {
    width: 100%;
  }
  .phone {
    position: absolute;
    right: clamp(16px, 4vw, 56px);
    bottom: clamp(16px, 3vw, 40px);
    width: clamp(100px, 20%, 220px);
    padding: 6px;
    background: var(--term);
    border-radius: 24px;
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.6);
  }
  .phone img {
    border-radius: 18px;
    aspect-ratio: 390 / 720;
    object-fit: cover;
    object-position: top;
  }
  .stage-qa {
    display: grid;
    place-items: center;
    padding: clamp(28px, 6vw, 80px) clamp(16px, 4vw, 48px);
    background: var(--qa-panel);
  }
  .report {
    display: grid;
    gap: 12px;
    width: min(560px, 100%);
    padding: clamp(20px, 3vw, 32px);
    border-radius: 12px;
    background: var(--term-text);
    color: #151513;
    font-family: var(--mono);
    font-size: 0.9rem;
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px dashed #bdb9ab;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #66655c;
  }
  .report ul {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .flows li {
    display: flex;
    gap: 10px;
  }
  .report .tick {
    color: #15744a;
    font-weight: 700;
  }
  /* Pass/fail bar: the real split of a test run */
  .run {
    display: grid;
    gap: 10px;
  }
  .run-title {
    font-weight: 600;
  }
  .bar {
    display: grid;
    gap: 3px;
    height: 14px;
  }
  .bar span {
    border-radius: 3px;
  }
  .bar-pass {
    background: #15744a;
  }
  .bar-fail {
    background: #b3261e;
  }
  .run-legend {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.8rem;
  }
  .run-legend .pass {
    color: #15744a;
  }
  .run-legend .fail {
    color: #b3261e;
  }
  .bugs {
    display: grid;
    gap: 10px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px dashed #bdb9ab;
  }
  .bugs-title {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #66655c;
  }
  .ticket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    padding: 10px 12px;
    border: 1px solid #d6d2c4;
    border-radius: 8px;
    background: #fbfaf5;
  }
  .ticket-id {
    font-weight: 600;
  }
  .sev {
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sev-high {
    background: #fbe4e1;
    color: #8f1d14;
  }
  .sev-medium {
    background: #fbefd6;
    color: #6e4400;
  }
  .sev-low {
    background: #e4efe8;
    color: #15744a;
  }
  .ticket-title {
    flex-basis: 100%;
    font-family: var(--sans, inherit);
    line-height: 1.4;
  }
  .report-note {
    margin-top: 6px;
    font-size: 0.78rem;
    color: #66655c;
  }

  /* Reading column */
  .case-body {
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: clamp(40px, 6vw, 80px) 0;
  }
  .block + .block,
  .quote + .block,
  .block + .quote {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .block h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 720;
    letter-spacing: -0.025em;
  }
  .block p,
  .points {
    max-width: 65ch;
  }
  .block p {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .points {
    display: grid;
    gap: 12px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }
  .points li {
    position: relative;
    padding-left: 26px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.65em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--pass);
  }
  .outcome {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--pass-tint);
    color: var(--ink) !important;
    font-weight: 500;
  }

  .scores {
    margin-top: 24px;
  }
  .scores ul {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    padding: 0;
    list-style: none;
  }
  .scores li {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 84px;
  }
  .score-value {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--paper) 82%, transparent 84%),
      conic-gradient(var(--pass) calc(var(--score) * 1%), var(--line) 0);
    font-family: var(--mono);
    font-weight: 500;
    color: var(--pass);
  }
  .score-label {
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: center;
    line-height: 1.3;
  }
  @media (max-width: 480px) {
    .scores ul {
      gap: 10px;
    }
    .scores li {
      width: 72px;
    }
  }
  .score-note {
    font-family: var(--mono);
    font-size: 0.75rem !important;
    color: var(--ink-3) !important;
  }

  .quote {
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
  }
  .quote blockquote {
    margin: 0;
  }
  .quote blockquote p {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .quote figcaption {
    display: grid;
    margin-top: 18px;
  }
  .quote figcaption span {
    color: var(--ink-3);
    font-size: 0.92rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .next {
    margin-top: clamp(56px, 8vw, 112px);
    margin-bottom: clamp(56px, 8vw, 112px);
  }
  .next a {
    display: grid;
    gap: 6px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 20px;
    background: var(--paper-2);
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .next-title {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    font-weight: 720;
    letter-spacing: -0.03em;
  }
  .next-count {
    color: var(--ink-3);
  }
  .next-kind {
    color: var(--ink-3);
  }
  @media (hover: hover) and (pointer: fine) {
    .next a:hover {
      background: var(--line);
    }
  }
</style>
